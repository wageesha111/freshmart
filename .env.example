# ============================================================
# FreshMart environment variables
# Copy this file to .env.local and fill in the values.
# Never commit .env / .env.local to git.
# ============================================================

# --- Supabase (optional: without these the app runs in local demo mode) ---
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
# REQUIRED when Supabase is used. Server-only secret: never add NEXT_PUBLIC_ to it.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Security (required in production) ---
# Random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
# Passcode for the /admin owner dashboard. Use a long, unique password.
ADMIN_PASSWORD=""

# --- Optional ---
# Allow the one-click "Quick Demo" sign-in buttons in production (handy for a portfolio demo).
# ENABLE_DEMO_LOGIN="true"
